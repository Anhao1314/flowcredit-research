{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flowcredit:research:span-proposal:v0.7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subjectId",
    "sourceId",
    "chunkId",
    "modelProvider",
    "modelName",
    "modelVersion",
    "promptVersion",
    "inputHash",
    "outputHash",
    "quoteHash",
    "createdAt",
    "quote",
    "factKind",
    "validationStatus",
    "findings",
    "inputSnapshot",
    "promptHash"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "subjectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "chunkId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "modelProvider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "modelName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "promptVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "inputHash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "outputHash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "quoteHash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "createdAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "quote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "factKind": {
      "enum": [
        "financial_metric",
        "customer_concentration",
        "guidance",
        "risk_disclosure",
        "operating_fact",
        "liquidity_fact",
        "debt_fact",
        "cash_flow_fact",
        "capex_fact",
        "backlog_or_rpo",
        "other_explicit_fact"
      ]
    },
    "validationStatus": {
      "enum": [
        "verified",
        "rejected"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "inputSnapshot": {
      "type": "object"
    },
    "promptHash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  }
}
