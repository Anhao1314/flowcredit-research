{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claimHandle",
    "baseRevisionHandle",
    "impact",
    "suggestedStatus",
    "suggestedConfidenceDirection",
    "reasonCode",
    "attributions"
  ],
  "properties": {
    "claimHandle": {
      "const": "C1"
    },
    "baseRevisionHandle": {
      "const": "R1"
    },
    "impact": {
      "enum": [
        "confirm",
        "strengthen",
        "weaken",
        "contradict",
        "no_material_effect",
        "insufficient_evidence"
      ]
    },
    "suggestedStatus": {
      "enum": [
        "supported",
        "partially_supported",
        "disputed",
        "unverified",
        "stale"
      ]
    },
    "suggestedConfidenceDirection": {
      "enum": [
        "increase",
        "decrease",
        "unchanged"
      ]
    },
    "reasonCode": {
      "enum": [
        "new_supporting_evidence",
        "new_counter_evidence",
        "conflicting_evidence",
        "period_update",
        "metric_deterioration",
        "metric_improvement",
        "source_correction",
        "insufficient_support",
        "no_relevant_change"
      ]
    },
    "attributions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidenceHandle",
          "relation",
          "quote"
        ],
        "properties": {
          "evidenceHandle": {
            "type": "string",
            "pattern": "^E[1-8]$"
          },
          "relation": {
            "enum": [
              "supports",
              "counters",
              "context",
              "unclear"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
