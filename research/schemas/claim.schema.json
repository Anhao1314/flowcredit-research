{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flowcredit:research:claim:v0.1",
  "title": "claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subjectId",
    "statement",
    "category",
    "supportingEvidenceIds",
    "counterEvidenceIds",
    "confidence",
    "status",
    "method",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "subjectId": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "supportingEvidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "counterEvidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "enum": [
        "supported",
        "partially_supported",
        "disputed",
        "unverified",
        "stale"
      ]
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "supported"
          }
        }
      },
      "then": {
        "properties": {
          "supportingEvidenceIds": {
            "minItems": 1,
            "type": "array"
          },
          "confidence": {
            "exclusiveMinimum": 0,
            "type": "number"
          }
        }
      }
    }
  ]
}
