{
  "name": "flowcredit-agent-sidecar",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "cli": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "test:public-api": "node --test test/public-api.test.js",
    "test:finch-contract": "node --test test/finch-contract.test.js",
    "smoke:external-alpha": "node scripts/external-alpha-smoke.js",
    "validate:public-api": "node scripts/validate-public-api.js",
    "validate:finch-contract": "node scripts/validate-finch-contract.js",
    "verify:release": "node scripts/verify-release.js",
    "verify:finch-submission": "node scripts/verify-finch-submission.js",
    "check": "npm run check:syntax && npm run check:frontend && npm run typecheck && npm test",
    "typecheck": "tsc -p tsconfig.json",
    "check:syntax": "node scripts/check-syntax.js",
    "check:frontend": "node scripts/check-frontend-discipline.js"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sdk-client": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "@types/node": "26.5.0"
  }
}
